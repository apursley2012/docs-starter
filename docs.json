{
  "$schema": "https://mintlify.com/docs.json",
  "name": "PunctuOwlity",
  "theme": "sequoia",

  "fonts": {
    "heading": {
      "family": "Cormorant Upright",
      "weight": 700
    },
    "body": {
      "family": "Aref Ruqaa",
      "weight": 400
    }
  },

  "colors": {
    "primary": "#2fc7c9",
    "light": "#eb656d",
    "dark": "#000050"
  },

  "logo": {
    "light": "Punctuowlity-logo.PNG",
    "dark": "Punctuowlity-logo.PNG",
    "href": "https://apursley2012.github.io/punctuowlity"
  },

  "favicon": "/Punctuowlity-logo.PNG",

  "navbar": {
    "primary": {
      "type": "button",
      "label": "Open App",
      "href": "https://apursley2012.github.io/punctuowlity"
    }
  },

  "navigation": {
    "tabs": [
      {
        "tab": "Guide",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "quickstart",
              "account-setup"
            ]
          },
          {
            "group": "Using PunctuOwlity",
            "pages": [
              "events/overview",
              "events/add-edit-delete",
              "events/categories",
              "events/search"
            ]
          },
          {
            "group": "Reminders",
            "pages": [
              "reminders/overview",
              "reminders/sms-notifications",
              "reminders/browser-notifications"
            ]
          },
          {
            "group": "Help",
            "pages": [
              "faq",
              "troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "Learn",
        "groups": [
          {
            "group": "Articles",
            "pages": [
              "articles/useful-reminders",
              "articles/responsive-conversion"
            ]
          },
          {
            "group": "Case Study",
            "pages": [
              "case-study/overview",
              "case-study/design-decisions"
            ]
          }
        ]
      }
    ]
  }
}
